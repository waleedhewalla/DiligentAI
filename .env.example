# ─── Site ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://diligentai.com
# Local: NEXT_PUBLIC_SITE_URL=http://localhost:3300

# ─── Supabase (Auth, Postgres + RLS) ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Cross-product SSO (scoped launch tokens, one secret per product) ────
# Generate each with: openssl rand -base64 48
IPE_SECRET_KEY=
CEO_OS_SECRET_KEY=
NEXUS_SECRET_KEY=
IPE_APP_URL=https://ipe.diligentai.com
CEO_OS_APP_URL=https://ceo.diligentai.com
NEXUS_APP_URL=https://nexus.diligentai.com


# ─── Booking & contact ───────────────────────────────────────────────────
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/diligentai/30min
NEXT_PUBLIC_CALENDLY_CEO_URL=https://calendly.com/diligentai/ceo-15min
# International format, digits only, e.g. 2010XXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/waleedhewalla
# Company channels — each footer icon appears only when set.
NEXT_PUBLIC_LINKEDIN_COMPANY_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_X_URL=

# ─── Analytics & SEO monitoring ──────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_HOTJAR_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_AHREFS_SITE_VERIFICATION=
NEXT_PUBLIC_SEMRUSH_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ─── Nexus AI live demo widget (optional) ────────────────────────────────
# If unset, the widget returns curated sample output instead of live generation.
ANTHROPIC_API_KEY=

# ─── Demo-request notifications (optional) ───────────────────────────────
# Any HTTPS endpoint (Slack/Teams/Make/Zapier/Notion automation) that should receive new demo requests.
DEMO_REQUEST_WEBHOOK_URL=
NEXT_PUBLIC_OVERVIEW_VIDEO_URL=
