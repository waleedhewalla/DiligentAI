# ─── Site ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://velixi.ai
# Local: NEXT_PUBLIC_SITE_URL=http://localhost:3300

# ─── Supabase (Auth, Postgres + RLS) ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Cross-product SSO (scoped launch tokens, one secret per product) ────
# Generate each with: openssl rand -base64 48
IPE_SECRET_KEY=
CEO_OS_SECRET_KEY=
NEXUS_SECRET_KEY=
IPE_APP_URL=https://ipe.velixi.ai
CEO_OS_APP_URL=https://ceo.velixi.ai
NEXUS_APP_URL=https://nexus.velixi.ai


# ─── Booking & contact ───────────────────────────────────────────────────
# Public Cal.com event link (preferred), e.g. https://cal.com/<username>/30min
NEXT_PUBLIC_BOOKING_URL=https://cal.com/waleed-hewalla-trzjna/15min
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/velixi/30min
NEXT_PUBLIC_CALENDLY_CEO_URL=https://calendly.com/velixi/ceo-15min
# International format, digits only, e.g. 2010XXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=201065307007
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/waleedhewalla
# Company channels — each footer icon appears only when set.
NEXT_PUBLIC_LINKEDIN_COMPANY_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# ─── Analytics & SEO monitoring ──────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_HOTJAR_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_AHREFS_SITE_VERIFICATION=
NEXT_PUBLIC_SEMRUSH_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ─── Nexus AI live demo widget (optional) ────────────────────────────────
# If no key is set, the widget returns curated sample output instead of live generation.
# OpenRouter (used first when set) – defaults to the free NVIDIA Nemotron Nano model,
# resolved from OpenRouter's model list; pin one with NEXUS_OPENROUTER_MODEL.
OPENROUTER_API_KEY=
NEXUS_OPENROUTER_MODEL=
# Claude via the Anthropic API (used when OpenRouter is not set, or NEXUS_PROVIDER=anthropic).
ANTHROPIC_API_KEY=
# Optional: force a provider – openrouter | anthropic | sample
NEXUS_PROVIDER=

# ─── Demo-request notifications (optional) ───────────────────────────────
# Any HTTPS endpoint (Slack/Teams/Make/Zapier/Notion automation) that should receive new demo requests.
DEMO_REQUEST_WEBHOOK_URL=
NEXT_PUBLIC_OVERVIEW_VIDEO_URL=
